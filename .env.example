# =================================================================
# Games of the Generals - Environment Configuration
# =================================================================
#
# Copy this file to .env.local and fill in your actual values.
# Never commit your actual .env.local file to version control.
#
# For detailed setup instructions, see: https://docs.convex.dev/

# =================================================================
# CONVEX BACKEND CONFIGURATION
# =================================================================

# Your Convex deployment URL
# Get this from: https://dashboard.convex.dev/
# Format: https://steady-pika-242.convex.cloud
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Set to "true" to serve the static maintenance page without connecting to Convex.
# VITE_MAINTENANCE_MODE=true

# =================================================================
# PUSH NOTIFICATIONS (WEB PUSH API)
# =================================================================

# VAPID keys for push notifications
# Generate these using: npx web-push generate-vapid-keys
# Or use an online VAPID key generator
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Contact email for push notification issues
# This should be a valid email address for push service providers
VAPID_CONTACT_EMAIL=mailto:admin@gamesofgenerals.app

# =================================================================
# APPLICATION URLS
# =================================================================

# Your application'\''s base URL
# For production: https://generalsonline.app
# For development: http://localhost:5173
SITE_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# =================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =================================================================

# Vercel Analytics (optional)
# Get from: https://vercel.com/dashboard/integrations/analytics
# VITE_VERCEL_ANALYTICS_ID=your_analytics_id

# Vercel Speed Insights (optional)
# Get from: https://vercel.com/dashboard/integrations/speed-insights
# VITE_VERCEL_SPEED_INSIGHTS_ID=your_insights_id

# =================================================================
# OPTIONAL: EMAIL SERVICE (CLOUDFLARE EMAIL SENDING)
# =================================================================

# Set these on the Convex deployment (npx convex env set ...), not in Vite.
# Token needs the Email Sending permission for the account that owns the sending domain.
# Get from: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_EMAIL_API_TOKEN=your_cloudflare_api_token

# =================================================================
# DEVELOPMENT SETTINGS
# =================================================================

# Enable debug logging (development only)
# DEBUG=true

# Enable React Query devtools (development only)
# REACT_QUERY_DEVTOOLS=true

# =================================================================
# SECURITY NOTES
# =================================================================
#
# 🔐 SECURITY BEST PRACTICES:
#
# 1. Never commit actual secrets to version control
# 2. Use different keys for development and production
# 3. Rotate keys regularly
# 4. Use environment-specific configurations
# 5. Store secrets securely (consider using secret management services)
#
# 🚨 IMPORTANT:
#
# - .env.local files should be added to .gitignore
# - Use strong, unique keys for production
# - Test with development keys first
# - Document any custom environment variables you add
#
# =================================================================
# GETTING STARTED CHECKLIST
# =================================================================
#
# □ Clone the repository
# □ Copy this file to .env.local
# □ Set up Convex account and deployment
# □ Generate VAPID keys for push notifications
# □ Configure your domain/URLs
# □ Test the application locally
# □ Deploy to production
#
# For detailed setup instructions, see the README.md file.
# =================================================================
